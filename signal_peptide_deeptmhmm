# compruebo si la distribución de tmrs depende de la clase de ORF
# como hay menos de n=5, en vez de chi2, hago prueba exacta de fisher
tabla_topologia <- table(analisis_topologia$orf_class, 
                         analisis_topologia$perfil_topologico)

test_fisher_global <- fisher.test(tabla_topologia, simulate.p.value = TRUE, B = 10000)
test_fisher_global <- tidy(test_fisher_global)

addWorksheet(wb, "test_fisher_global")
writeData(wb, "test_fisher_global", test_fisher_global)

# ahora veo el pvalor de cada grupo
totales_orf <- analisis_topologia |> count(orf_class, name = "total_clase")

total_cds_val <- analisis_topologia |> filter(orf_class == "CDS") |> nrow()

datos_cds_perfil <- analisis_topologia |> 
  filter(orf_class == "CDS") |> 
  count(perfil_topologico, name = "n_cds")

# test de Fisher 2x2 para cada combinación de ORF y perfil topológico
resultados_fisher <- analisis_topologia |>
  filter(orf_class != "CDS") |>
  count(orf_class, perfil_topologico, name = "n_orf") |>
  left_join(totales_orf, by = "orf_class") |>
  left_join(datos_cds_perfil, by = "perfil_topologico") |>
  mutate(total_cds = total_cds_val) |>
  rowwise() |>
  mutate(
    p_value = fisher.test(
      matrix(c(
        n_orf,             total_clase - n_orf,
        n_cds,             total_cds - n_cds
      ), nrow = 2, byrow = TRUE)
    )$p.value
  ) |>
  ungroup() |>
  # Corrección por múltiples comparaciones (FDR)
  mutate(
    p_adj = p.adjust(p_value, method = "fdr"),
    significancia = case_when(
      p_adj < 0.001 ~ "***",
      p_adj < 0.01  ~ "**",
      p_adj < 0.05  ~ "*",
      TRUE          ~ "ns"
    )
  )

addWorksheet(wb, "resultados_fisher")
writeData(wb, "resultados_fisher", resultados_fisher)

# Guardar
saveWorkbook(wb, ruta_completa, overwrite = TRUE)


