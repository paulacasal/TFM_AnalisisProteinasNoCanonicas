## Fig 18: DATA ANALYSIS de los datos obtenidos mediante el software deepTMHMM
# en este script se analizan los signal peptides con el fin de saber cuáles proteínas entran a la vía secretora

# importación paleta colores y librería
source("Yo/Figuras/library.R")
source("Yo/Figuras/mipaleta_orfs.R")
source("Yo/Figuras/Setup_figuras.R")

# datos del script
importacion_datos <- read_csv("Yo/DATA_Figuras/Deep_tmhmm_20260712_noCDS.csv") |> 
  # elimino primera col que es un id que se me creó y luego sino el fulljoin se hará mal
  select(-1) |> 
  # viene con 22 NA, como son microproteínas, y es raro que tengan dominios
  # les asigno 0
  mutate(num_tmrs = replace_na(num_tmrs, 0))
importacion_datos2 <- read_csv("Yo/DATA_Figuras/Deep_tmhmm_20260721_CDS.csv") |> 
  select(-1) 

col_noCDS <- importacion_datos|> 
  mutate(orf_class = "no CDS") 

resto_col <- importacion_datos |> 
  full_join(importacion_datos2, by = c("gene_name", "cdna", "amino_acid_sequence",
                                       "num_tmrs", "inicio", "fin", "tipo_region")) |> 
  mutate(orf_class = if_else(!is.na(uniprot_id), "CDS", orf_class)) 

datos_finales <- bind_rows(col_noCDS, resto_col)

# quiero ver si cuando hay sp también tm para ver si existe función real biológica
analisis_topologia <- datos_finales |>
  mutate(id_unificado = coalesce(orf_id, uniprot_id)) |>
  group_by(id_unificado, orf_class) |>
  summarise(
    tiene_sp = any(tipo_region == "signal", na.rm = TRUE),
    tiene_tm = any(tipo_region == "TMhelix", na.rm = TRUE), 
    .groups = "drop"
  ) |>
  mutate(
    perfil_topologico = case_when(
      tiene_sp & !tiene_tm ~ "SP",
      tiene_sp & tiene_tm  ~ "SP + TM",
      !tiene_sp & tiene_tm ~ "TM",
      TRUE                 ~ "None"
    ),
    #para ordenar
    perfil_topologico = factor(perfil_topologico, 
                               levels = c("None", 
                                          "SP", 
                                          "TM", 
                                          "SP + TM"))
  ) |> 
  ungroup() |> 
  mutate(orf_class = factor(orf_class, levels = orden_orf)) 

datos_plot1 <- analisis_topologia |>
  count(orf_class, perfil_topologico, name = "n") |>
  # el total de cada clase
  group_by(orf_class) |>
  mutate(
    total_orf = sum(n),
    porcentaje = (n / total_orf) * 100
  ) |>
  ungroup() 

p1 <- ggplot(datos_plot1, aes(x = perfil_topologico, y = porcentaje, fill = orf_class)) +
  geom_col(linewidth = 0.3, show.legend = FALSE) +
  geom_text(
    aes(label = sprintf("%d", n)),
    vjust = -0.2,
    size = 5,
  ) +
  facet_wrap(~ orf_class, nrow = 3) +
  scale_fill_manual(values = colores_orfs) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.14))) +
  labs(title = "Distribution of Topological Profiles by ORF Subtype", 
       y = "Percentage (%)",
       x = "ORF subtype") +
  theme_minimal(base_size = 18) + 
  theme(legend.position = "none",
        panel.border = element_rect(color = "black", fill = NA, linewidth = 1))

print(p1)

